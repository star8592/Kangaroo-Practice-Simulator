[Unit]
Description=SocThink World Math Official Source Monitor (review-only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=socthink-competition-source-watch
StateDirectoryMode=0700
WorkingDirectory=/opt/socthink-math
Environment=NODE_ENV=production
Environment=SOCTHINK_SOURCE_WATCH_DIR=/var/lib/socthink-competition-source-watch
ExecStart=/opt/socthink-math/node_modules/.bin/tsx /opt/socthink-math/scripts/watch_competition_sources.ts
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
UMask=0077
