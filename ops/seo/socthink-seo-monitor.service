[Unit]
Description=SOC THINK public SEO crawl monitor (read-only daily report)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/socthink-releases/current
# The runtime data directory is owned by numeric UID/GID 1000, but there is
# no passwd entry for that UID on this server. Drop credentials numerically.
Environment=SOCTHINK_USER_DATA_DIR=/opt/socthink-math/private/users
ExecStart=/usr/bin/setpriv --reuid=1000 --regid=1000 --clear-groups /usr/bin/node /opt/socthink-releases/current/scripts/seo_monitor_daily.mjs
TimeoutStartSec=160
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/socthink-math/private/users
UMask=0077
