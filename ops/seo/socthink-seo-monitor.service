[Unit]
Description=SOC THINK public SEO crawl monitor (read-only daily report)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/socthink-releases/current
# SEO-only runtime history (never identities) is owned by numeric UID/GID 1000;
# no passwd entry for that UID on this server. Drop credentials numerically.
Environment=SOCTHINK_SEO_DATA_DIR=/opt/socthink-math/private/seo
ExecStart=/usr/bin/setpriv --reuid=1000 --regid=1000 --clear-groups /usr/bin/node /opt/socthink-releases/current/scripts/seo_monitor_daily.mjs
TimeoutStartSec=480
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/socthink-math/private/seo
UMask=0077
