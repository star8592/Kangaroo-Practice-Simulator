    "solution:materialize": "python3 scripts/materialize_verified_solutions.py",
    "solution:materialize-queue": "python3 scripts/build_solution_materialization_queue.py",
    "solution:factory": "python3 scripts/run_solution_factory.py",
    "test:math-dsl": "tsx scripts/test_math_dsl.ts",
    "test:arithmetic-print-live": "tsx scripts/smoke_arithmetic_print_live.ts",
