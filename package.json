    "test:maa": "tsx scripts/test_maa_scoring.ts",
    "test:maa-library": "python3 scripts/validate_maa_library.py",
    "test:competition-identity": "python3 scripts/test_competition_identity.py",
    "test:aime-sections": "tsx scripts/test_aime_sections.ts",
    "test:maa-smart": "tsx scripts/test_maa_smart.ts",
    "test:solution-books": "tsx scripts/test_solution_books.ts",
    "test:verified-storyboards": "tsx scripts/test_verified_storyboards.ts",
    "solution:queue": "tsx scripts/build_solution_queue.ts",
    "test:maa-verified-store": "tsx scripts/test_maa_verified_store.ts",
    "data:manifest": "tsx scripts/build_student_ready_manifest.ts",
    "data:publish-source": "bash ops/data/promote_verified_sources.sh",
    "data:publish-ready": "bash ops/data/promote_student_ready.sh",
